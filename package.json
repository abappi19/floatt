{
  "name": "floatt",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@floatt/web",
    "dev:desktop": "bun run --filter @floatt/desktop tauri dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check-types": "turbo run check-types"
  },
  "dependencies": {
    "@floatt/app": "workspace:*"
  },
  "devDependencies": {
    "turbo": "^2.11.7"
  }
}
